# Connexiba — Apache config for static multilingual hosting (Namecheap shared hosting)
# This file must sit in the SAME folder as index.html (the public_html root,
# or whatever folder your domain actually points to).

# ---------------------------------------------------------------------
# 0. Root -> /en/ redirect, at the HTTP level, before any HTML is sent.
#    Matches ONLY the bare domain root ("/") — a direct "/index.html"
#    request is intentionally NOT matched, nor is any other URL
#    (/en/, /de/, /assets/..., etc.). 301 (permanent) since
#    English-as-default is a fixed, long-term routing decision, not a
#    temporary one.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^$ en/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------
# 1. Make sure index.html is recognized as the default document in every
#    folder (root, /en/, /de/, etc.) — this is usually already the Apache
#    default, but setting it explicitly removes any doubt.
# ---------------------------------------------------------------------
DirectoryIndex index.html

# ---------------------------------------------------------------------
# 2. Compression (fixes the "Enable text compression" Lighthouse finding)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 3. Caching (fixes the "Uses efficient cache policy" Lighthouse finding)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------------------
# 4. Security headers (low-risk, standard hardening)
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# NOTE: root/index.html still contains its own client-side fallback
# (<meta http-equiv="refresh"> to "en/index.html") for the rare case a
# host serves this file without reading .htaccess (e.g. mod_rewrite
# disabled). On any normal Apache/LiteSpeed setup, the rule in section 0
# above fires first and that fallback is never seen. If you later want
# language auto-detection (Accept-Language based redirect to /de/, /fr/,
# etc. instead of always /en/), that can be added as additional
# RewriteCond/RewriteRule lines in section 0.
